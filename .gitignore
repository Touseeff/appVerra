# Local secrets — never commit
includes/config.local.php
.env

# Blog factory — local-only run artifacts (drafts in queue/pending/ ARE committed)
blog_factory/runs/
blog_factory/.env
blog_factory/.import-token
blog_factory/auto-import.log
blog_factory/queue/published.json

# Third-party WYSIWYG bundle — install on server, do not commit
admin/assets/tinymce/

# User-uploaded media
uploads/*
!uploads/.htaccess
!uploads/.gitkeep

# OS / editor noise
.DS_Store
Thumbs.db
*.bak
