# =============================================
# AppVerra .htaccess — Performance & SEO
# =============================================

Options -Indexes

# Force HTTPS
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Remove www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Serve favicon.ico directly from root
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^favicon\.ico$ - [L]

# Deny public web access to the entire blog_factory/ tree.
# It contains: unreviewed draft posts, intermediate AI run artifacts, brand
# voice guides, and the local .env reference. None of it should be browseable.
# Server-side PHP (import-pending.php) reads these files via the filesystem,
# which is unaffected by mod_rewrite rules.
# Placed early so it fires BEFORE any rewrite rules can match.
RewriteRule ^blog_factory/ - [F,L]

# Deny public web access to guide_src/ — the print-HTML source used to render the
# downloadable PDF guide(s). The rendered PDF in /assets/downloads/ stays public; only
# the raw HTML source is hidden (avoids duplicate-content and keeps the web root clean).
RewriteRule ^guide_src/ - [F,L]

# 301 redirect: fix "hands-fee" typo in voice commerce blog slug
RewriteRule ^voice-commerce-in-2025-how-to-enable-hands-fee-shopping-in-your-app/?$ /voice-commerce-in-2025-how-to-enable-hands-free-shopping-in-your-app [R=301,L]

# 301 redirect: Unity game development discontinued — send to services overview
RewriteRule ^unity-game-development(\.php)?/?$ /our-services [R=301,L]

# Services hub: bare /services (a real directory of child pages) -> our-services overview.
# Child pages like /services/ios-app-development resolve normally via the clean-URL rule below.
RewriteRule ^services/?$ /our-services [R=301,L]

# 301: flat service URLs migrated into the /services/ silo (one canonical home each).
# Placed before the clean-URL serve rule so the old flat paths redirect rather than 404.
RewriteRule ^flutter-app-development/?$ /services/flutter-app-development [R=301,L]
RewriteRule ^react-native-developer/?$ /services/react-native-app-development [R=301,L]
RewriteRule ^full-stack-development/?$ /services/full-stack-development [R=301,L]
RewriteRule ^mobile-app-marketing/?$ /services/mobile-app-marketing [R=301,L]
RewriteRule ^ecommerce/?$ /services/ecommerce-app-development [R=301,L]

# Industries hub: serve /industries from the root industries.php. The /industries/ directory holds
# child pages; this explicit rewrite fires before mod_dir, so there is no DirectorySlash redirect loop.
# Child pages like /industries/fintech-app-development resolve normally via the clean-URL rule below.
RewriteRule ^industries/?$ industries.php [L]

# Locations hub: serve /locations from the root locations.php (same pattern as /industries).
RewriteRule ^locations/?$ locations.php [L]

# 301: flat city URLs migrated into the /locations/ silo (slug preserved).
RewriteRule ^new-york-app-development/?$ /locations/new-york-app-development [R=301,L]
RewriteRule ^los-angeles-app-development/?$ /locations/los-angeles-app-development [R=301,L]
RewriteRule ^san-francisco-app-development/?$ /locations/san-francisco-app-development [R=301,L]
RewriteRule ^chicago-app-development/?$ /locations/chicago-app-development [R=301,L]
RewriteRule ^austin-app-development/?$ /locations/austin-app-development [R=301,L]
RewriteRule ^miami-app-development/?$ /locations/miami-app-development [R=301,L]
RewriteRule ^dallas-app-development/?$ /locations/dallas-app-development [R=301,L]
RewriteRule ^seattle-app-development/?$ /locations/seattle-app-development [R=301,L]

# Serve llms.txt and llms-full.txt through PHP to bypass Hostinger WAF bot-blocking
RewriteRule ^llms\.txt$ llms-txt.php [L]
RewriteRule ^llms-full\.txt$ llms-full-txt.php [L]

# Normalize trailing slashes on non-directory URLs (e.g. /services/ios-app-development/ -> /services/ios-app-development)
# Real directories are excluded (!-d) so /blog_factory/ etc. are untouched.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Remove .php extension from URLs
# Redirect /page.php to /page (301 permanent)
RewriteCond %{THE_REQUEST} /([^.]+)\.php [NC]
RewriteRule ^ /%1 [R=301,L]

# Internally serve /page as /page.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^.]+)$ $1.php [L]

# Dynamic blog routing — if a slug doesn't match any real file or .php,
# treat it as a blog post and dispatch to blog-post.php
RewriteCond %{REQUEST_FILENAME}    !-d
RewriteCond %{REQUEST_FILENAME}    !-f
RewriteCond %{REQUEST_FILENAME}.php !-f
RewriteRule ^([a-z0-9-]+)/?$ blog-post.php?slug=$1 [L,QSA]

# Deny direct access to backend includes
<FilesMatch "\.(sql|env)$">
  Require all denied
</FilesMatch>
<Files "config.php">
  Require all denied
</Files>

# =============================================
# GZIP Compression
# =============================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE image/svg+xml application/font-woff application/font-woff2
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2
</IfModule>

# =============================================
# Browser Caching
# =============================================
<IfModule mod_expires.c>
  ExpiresActive On

  # Images
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # CSS & JS
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # HTML & PHP
  ExpiresByType text/html "access plus 1 hour"

  # Video
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

# =============================================
# Cache-Control Headers
# =============================================
<IfModule mod_headers.c>
  <FilesMatch "\.(ico|jpg|jpeg|png|webp|gif|svg|mp4)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff|woff2|ttf|otf)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "max-age=3600, public, must-revalidate"
  </FilesMatch>

  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # HSTS — pin HTTPS for 1 year (HTTPS is already forced above)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  # Conservative CSP — upgrade any http subresource + restrict framing (complements X-Frame-Options)
  Header always set Content-Security-Policy "upgrade-insecure-requests; frame-ancestors 'self'"

  # Keep-Alive
  Header set Connection keep-alive
</IfModule>

# =============================================
# ETags
# =============================================
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
FileETag None

# =============================================
# Serve pre-compressed files if available
# =============================================
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{REQUEST_FILENAME}\.gz -f
  RewriteRule ^(.*)$ $1.gz [QSA,L]
</IfModule>

# =============================================
# Custom Error Pages
# =============================================
ErrorDocument 404 /404.php
