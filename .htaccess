# =============================================
# AppVerra .htaccess — Performance & SEO
# =============================================

Options -Indexes

# Force HTTPS
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Remove www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Serve favicon.ico directly from root
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^favicon\.ico$ - [L]

# Deny public web access to the entire blog_factory/ tree.
# It contains: unreviewed draft posts, intermediate AI run artifacts, brand
# voice guides, and the local .env reference. None of it should be browseable.
# Server-side PHP (import-pending.php) reads these files via the filesystem,
# which is unaffected by mod_rewrite rules.
# Placed early so it fires BEFORE any rewrite rules can match.
RewriteRule ^blog_factory/ - [F,L]

# 301 redirect: fix "hands-fee" typo in voice commerce blog slug
RewriteRule ^voice-commerce-in-2025-how-to-enable-hands-fee-shopping-in-your-app/?$ /voice-commerce-in-2025-how-to-enable-hands-free-shopping-in-your-app [R=301,L]

# Serve llms.txt and llms-full.txt through PHP to bypass Hostinger WAF bot-blocking
RewriteRule ^llms\.txt$ llms-txt.php [L]
RewriteRule ^llms-full\.txt$ llms-full-txt.php [L]

# Remove .php extension from URLs
# Redirect /page.php to /page (301 permanent)
RewriteCond %{THE_REQUEST} /([^.]+)\.php [NC]
RewriteRule ^ /%1 [R=301,L]

# Internally serve /page as /page.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^.]+)$ $1.php [L]

# Dynamic blog routing — if a slug doesn't match any real file or .php,
# treat it as a blog post and dispatch to blog-post.php
RewriteCond %{REQUEST_FILENAME}    !-d
RewriteCond %{REQUEST_FILENAME}    !-f
RewriteCond %{REQUEST_FILENAME}.php !-f
RewriteRule ^([a-z0-9-]+)/?$ blog-post.php?slug=$1 [L,QSA]

# Deny direct access to backend includes
<FilesMatch "\.(sql|env)$">
  Require all denied
</FilesMatch>
<Files "config.php">
  Require all denied
</Files>

# =============================================
# GZIP Compression
# =============================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE image/svg+xml application/font-woff application/font-woff2
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2
</IfModule>

# =============================================
# Browser Caching
# =============================================
<IfModule mod_expires.c>
  ExpiresActive On

  # Images
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"

  # CSS & JS
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # HTML & PHP
  ExpiresByType text/html "access plus 1 hour"

  # Video
  ExpiresByType video/mp4 "access plus 1 year"
</IfModule>

# =============================================
# Cache-Control Headers
# =============================================
<IfModule mod_headers.c>
  <FilesMatch "\.(ico|jpg|jpeg|png|webp|gif|svg|mp4)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff|woff2|ttf|otf)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "max-age=3600, public, must-revalidate"
  </FilesMatch>

  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Keep-Alive
  Header set Connection keep-alive
</IfModule>

# =============================================
# ETags
# =============================================
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
FileETag None

# =============================================
# Serve pre-compressed files if available
# =============================================
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{REQUEST_FILENAME}\.gz -f
  RewriteRule ^(.*)$ $1.gz [QSA,L]
</IfModule>

# =============================================
# Custom Error Pages
# =============================================
ErrorDocument 404 /404.php
