# AppVerra Blog Factory — local environment
#
# Copy this file to `.env` (which is gitignored) and fill in real values.
#
# The /publish-blog slash command reads .env from this directory.

# Unsplash API access key (free tier: 50 requests/hour).
# Get yours at https://unsplash.com/developers → New Application
UNSPLASH_ACCESS_KEY=replace_me

# Optional: comma-separated list of authors to credit in unsplash_attribution.
# Leave blank to use whatever Unsplash returns.
UNSPLASH_ATTRIBUTION_OVERRIDE=
